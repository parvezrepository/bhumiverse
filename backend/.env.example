# BHUMIVerse Backend Environment Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase Configuration (Optional for offline demo mode, required for cloud production)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-key-placeholder
SUPABASE_JWT_SECRET=your-jwt-secret-placeholder
SUPABASE_STORAGE_BUCKET=land_documents

# OCR Configuration (mock, tesseract, or paddleocr)
OCR_ENGINE=mock_adapter
MAX_UPLOAD_SIZE_MB=15
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg
